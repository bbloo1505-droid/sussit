# =============================================================================
# SussIt environment variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# --- OpenAI (listing extract from screenshot / pasted text) -------------------
# Get key: https://platform.openai.com/api-keys
# Required for live extract. Without it, V0 falls back to Quest 3 demo data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Supabase (persist analyses, outcomes, sell-speed lifecycles) -------------
# Get from: Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- eBay Browse API (AU comps + sell-speed polling) --------------------------
# Get from: https://developer.ebay.com/my/keys
# Use Production keys for EBAY_AU comps; Sandbox for integration testing.
# Docs: docs/ebay-browse.md
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# sandbox | production
EBAY_ENVIRONMENT=production
# Marketplace for Australian listings (use EBAY_US only for Sandbox testing)
EBAY_MARKETPLACE_ID=EBAY_AU
EBAY_ITEM_LOCATION_COUNTRY=AU
# OAuth scope for Browse (application token)
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope

# --- eBay Marketplace Account Deletion (server-only) --------------------------
# Docs: docs/ebay-account-deletion.md
# Token: 32–80 chars, [A-Za-z0-9_-]; same value in eBay Developer portal
EBAY_DELETION_VERIFICATION_TOKEN=
# Exact public URL registered with eBay (no trailing slash unless registered)
EBAY_DELETION_ENDPOINT=https://YOUR_DOMAIN/api/ebay/account-deletion

# --- Optional: Vercel (set these in Vercel project settings for deploys) ------
# Same names as above; do not prefix secrets with VITE_ except Supabase anon/url.
